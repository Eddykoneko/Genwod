#!/usr/bin/env bash
# Met en production la version du code présente dans ce dossier.
# Appelé par la CI GitHub après chaque push validé (voir .github/workflows/ci.yml), ou à la main :
#   bash bin/deployer
# PHP_BIN / COMPOSER_BIN permettent de choisir d'autres exécutables que « php » et « composer ».
set -euo pipefail
cd "$(dirname "$0")/.."
# Les fichiers publiés (assets, cache) doivent rester lisibles par le serveur web.
umask 022

PHP="${PHP_BIN:-php}"
# Sur un hébergement mutualisé, « php » en ligne de commande peut être plus ancien que celui du site :
# on prend alors PHP 8.4+ là où les hébergeurs l'installent (ex. /opt/alt/php84 chez Hostinger).
if ! "$PHP" -r 'exit(PHP_VERSION_ID >= 80400 ? 0 : 1);' 2>/dev/null; then
    for alternatif in /opt/alt/php84/usr/bin/php /opt/alt/php85/usr/bin/php; do
        if [ -x "$alternatif" ]; then PHP="$alternatif"; break; fi
    done
fi
# Composer est lancé avec ce même PHP, sinon ses scripts (cache:clear…) tourneraient sur l'ancien.
if [ -n "${COMPOSER_BIN:-}" ]; then
    COMPOSER=("$COMPOSER_BIN")
else
    COMPOSER=("$PHP" "$(command -v composer)")
fi

mkdir -p var/log
journal() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a var/log/deploiements.log; }

if [ ! -f .env.local ]; then
    echo "Fichier .env.local absent : voir docs/deploiement-hostinger.md (étape 3)." >&2
    exit 1
fi
if ! "$PHP" -r 'exit(PHP_VERSION_ID >= 80400 ? 0 : 1);'; then
    echo "PHP 8.4 requis, « $PHP » est en $("$PHP" -r 'echo PHP_VERSION;') : indiquez son chemin dans PHP_BIN." >&2
    exit 1
fi

journal "Déploiement de $(git rev-parse --short HEAD) (PHP $("$PHP" -r 'echo PHP_VERSION;')) : $(git log -1 --format=%s)"
"${COMPOSER[@]}" install --no-dev --optimize-autoloader --no-interaction --no-progress
"$PHP" bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration
"$PHP" bin/console app:catalogue:importer --no-interaction
"$PHP" bin/console asset-map:compile
"$PHP" bin/console cache:clear
journal "Déploiement terminé."
