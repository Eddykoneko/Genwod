{% extends 'emails/_layout.html.twig' %}
{% block contenu %}
    <h1 style="font-size:22px;margin:0 0 12px">Bonjour {{ pseudo }},</h1>
    <p>Une réinitialisation de mot de passe a été demandée pour votre compte. Choisissez un nouveau mot de passe ici :</p>
    <p style="margin:24px 0"><a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="background:#ff5a1f;color:#ffffff;padding:13px 22px;border-radius:999px;text-decoration:none;font-weight:bold">Choisir un nouveau mot de passe</a></p>
    <p style="color:#5b616b;font-size:13px">Ce lien expire dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.</p>
{% endblock %}
