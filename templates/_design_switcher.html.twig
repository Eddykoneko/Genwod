{# Aperçu temporaire des 3 propositions de refonte graphique — à retirer une fois le design choisi. #}
{% set actuel = app.request.attributes.get('_design', '') %}
<nav class="design-switcher" aria-label="Aperçu des designs">
    <span>Design</span>
    {% for valeur, libelle in {'': 'Actuel', 'studio': 'Studio', 'performance': 'Performance', 'ludique': 'Ludique'} %}
        <a href="{{ path(app.current_route ?? 'app_accueil', app.current_route_parameters|merge(app.request.query.all)|merge({design: valeur})) }}" data-turbo="false" aria-current="{{ actuel == valeur ? 'true' : 'false' }}">{{ libelle }}</a>
    {% endfor %}
</nav>
