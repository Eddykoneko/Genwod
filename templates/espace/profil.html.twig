{% extends 'base.html.twig' %}

{% block title %}Paramètres du compte{% endblock %}

{% block body %}
    <p class="eyebrow">Mon espace</p>
    <h1 class="mb-2" style="font-size: clamp(1.8rem, 5vw, 2.6rem); text-transform: uppercase">Paramètres</h1>
    {{ include('espace/_nav.html.twig') }}

    <div class="grid grid-2" style="align-items:start">
        <section class="card">
            <div class="card-head"><h2>Profil</h2></div>
            {{ form_start(profil) }}
                {{ form_row(profil.pseudo) }}
                {{ form_row(profil.niveau) }}
                {{ form_row(profil.bio) }}
                <div class="form-grid">{{ form_row(profil.taille) }}{{ form_row(profil.poids) }}</div>
                <button class="btn btn-primary">Enregistrer</button>
            {{ form_end(profil) }}
        </section>

        <div class="stack" style="--stack: 16px">
            <section class="card">
                <div class="card-head"><h2>Mot de passe</h2></div>
                {{ form_start(motDePasse) }}
                    {{ form_rest(motDePasse) }}
                    <button class="btn">Changer le mot de passe</button>
                {{ form_end(motDePasse) }}
            </section>

            <section class="card">
                <div class="card-head"><h2>Mes données</h2></div>
                <p class="small muted">Conformément au RGPD, vous pouvez récupérer toutes vos données ou supprimer définitivement votre compte.</p>
                <a class="btn btn-outline mt-2" href="{{ path('app_espace_export') }}" data-turbo="false">{{ ux_icon('lucide:download') }} Exporter mes données (JSON)</a>

                <details class="mt-3">
                    <summary class="btn btn-danger">{{ ux_icon('lucide:trash-2') }} Supprimer mon compte</summary>
                    <form method="post" action="{{ path('app_espace_supprimer') }}" class="mt-2" data-turbo-confirm="Cette action est irréversible. Supprimer votre compte et toutes vos séances ?">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer-compte') }}">
                        <div class="form-row">
                            <label class="form-label" for="password-suppression">Confirmez avec votre mot de passe</label>
                            <input type="password" id="password-suppression" name="password" required autocomplete="current-password">
                        </div>
                        <button class="btn btn-danger">Supprimer définitivement</button>
                    </form>
                </details>
            </section>
        </div>
    </div>
{% endblock %}
