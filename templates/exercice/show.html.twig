{% extends 'base.html.twig' %}

{% block title %}WOD - {{ exercice.type }}{% endblock %}

{% block body %}
    <div class="wod-page">
        <div class="wod-card body-wrapper">
            <h1 class="wod-title">WOD : {{ exercice.type }}</h1>

            <div class="wod-meta">
                <span class="wod-date">
                    <i class="fa-regular fa-calendar"></i>
                    {{ exercice.createdAt|date('d/m/Y') }}
                </span>

                {% if exercice.duree is defined and exercice.duree is not null %}
                    <span class="wod-duration">
                        <i class="fa-solid fa-stopwatch"></i>
                        {{ exercice.duree }} min
                    </span>
                {% endif %}

                <span class="wod-difficulty">
                    <i class="fa-solid fa-fire"></i>
                    Difficulté : {{ exercice.difficulte }}
                </span>
            </div>

            <hr class="separateur">

            <p class="wod-description">
                {{ exercice.description }}
            </p>

            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <div class="wod-actions">
                    <a href="{{ path('enregistrer_exercice', {'id': exercice.id}) }}"
                       class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i> Enregistrer l'exercice
                    </a>

                    {# Like / Unlike #}
                    {% if not exercice.isLikedByUser(app.user) %}
                        <form action="{{ path('exercice_like', {'id': exercice.id}) }}" method="post">
                            <button type="submit" class="btn btn-warning btn-space">
                                <i class="bi bi-hand-thumbs-up"></i> Like
                            </button>
                        </form>
                    {% else %}
                        <form action="{{ path('exercice_like', {'id': exercice.id}) }}" method="post">
                            <button type="submit" class="btn btn-warning btn-space">
                                <i class="bi bi-hand-thumbs-up-fill"></i> Enlever
                            </button>
                        </form>
                    {% endif %}

                    {# Favori / Unfavori #}
                    {% if not exercice.isFavoritedByUser(app.user) %}
                        <form action="{{ path('app_favori', {'id': exercice.id}) }}" method="post">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-heart"></i> Favori
                            </button>
                        </form>
                    {% else %}
                        <form action="{{ path('app_favori', {'id': exercice.id}) }}" method="post">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-heart-fill"></i> Enlever
                            </button>
                        </form>
                    {% endif %}
                </div>

                <div class="wod-secondary-actions">
                    <a href="{{ path('app_commentaire_new', {'id': exercice.id}) }}"
                       class="btn btn-info">
                        <i class="fa-solid fa-comments"></i> Ajouter un commentaire
                    </a>
                </div>
            {% endif %}

            <div class="wod-back">
                <a href="{{ path('app_home') }}" class="btn btn-primary">
                    <i class="fa-solid fa-arrow-rotate-left"></i> Retour
                </a>
            </div>
        </div>
    </div>
{% endblock %}