{% extends 'base.html.twig' %}

{% block title %}Leaderboard{% endblock %}

{% block body %}
    <h1>Leaderboard</h1>

    <h2>Classement Global</h2>
    <table class="table" aria-label="Classement Global">
        <thead>
            <tr>
                <th>Utilisateur</th>
                <th>Score Total</th>
            </tr>
        </thead>
        <tbody>
            {% if globalLeaderboard is not empty %}
                {% for user in globalLeaderboard %}
                    <tr>
                        <td>{{ user.email }}</td>
                        <td>{{ user.totalScore|number_format(0, ',', ' ') }}</td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="2">Aucun utilisateur trouvé.</td>
                </tr>
            {% endif %}
        </tbody>
    </table>

    <h2>Classement par Exercice</h2>
    {% if exercices is not empty %}
        {% for exercice in exercices %}
            <h3>{{ exercice.name }}</h3>
            <table class="table" aria-label="Classement pour {{ exercice.name }}">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody>
                    {% if exercice.id in exerciseLeaderboards %}
                        {% for leaderboard in exerciseLeaderboards[exercice.id] %}
                            <tr>
                                <td>{{ leaderboard.user_id.email }}</td>
                                <td>{{ leaderboard.score|number_format(0, ',', ' ') }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="2">Aucun score trouvé pour cet exercice.</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        {% endfor %}
    {% else %}
        <p>Aucun exercice trouvé.</p>
    {% endif %}
{% endblock %}