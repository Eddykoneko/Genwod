{% extends 'base.html.twig' %}

{% block title %}Classement des athlètes{% endblock %}

{% block body %}
<header class="s-entete s-entete-ligne">
    <div><h1>Classement</h1><p class="s-lead">{{ periodes[periode] }}, aux points.</p></div>
    <nav class="s-seg s-seg-statique">{% for cle, libelle in periodes %}<a href="{{ path('app_classement', {periode: cle}) }}" {{ periode == cle ? 'aria-current="page"' }}>{{ libelle }}</a>{% endfor %}</nav>
</header>
{% if classement|length >= 3 %}
    <div class="s-podium">
        {% for place in [1, 2, 3] %}
            {% set l = classement[place - 1] %}
            <a class="s-card s-podium-{{ place }}" href="{{ path('app_athlete', {pseudo: l.pseudo}) }}">
                <span class="s-podium-rang">{{ place }}</span>
                <span class="s-avatar" style="--h: {{ l.teinte }}">{{ l.pseudo|slice(0, 2)|upper }}</span>
                <b>{{ l.pseudo }}</b><span class="s-muted">{{ l.points }} pts · {{ l.seances }} séances</span>
            </a>
        {% endfor %}
    </div>
{% endif %}
<section class="s-card">
    <ol class="s-classement s-classement-grand">
        {% for l in classement %}
            <li class="{{ app.user and app.user.id == l.id ? 'moi' }}">
                <span class="s-rang">{{ loop.index }}</span>
                <span class="s-avatar s-avatar-sm" style="--h: {{ l.teinte }}">{{ l.pseudo|slice(0, 2)|upper }}</span>
                <a href="{{ path('app_athlete', {pseudo: l.pseudo}) }}">{{ l.pseudo }}</a>
                <span class="s-muted s-cache-mobile">{{ l.seances }} séances</span>
                <b>{{ l.points }} pts</b>
            </li>
        {% else %}
            <li class="s-muted">Aucune séance sur cette période.</li>
        {% endfor %}
    </ol>
</section>
<p class="s-muted s-petit" style="margin-top:12px">{{ bareme.base }} pts par séance · +5/+10 intermédiaire/difficile · +{{ bareme.rx }} en RX · +{{ bareme.record }} pour un record</p>
{% endblock %}
