{% extends 'base.html.twig' %}

{% block title %}{{ wod.titre }} · {{ wod.format }}{% endblock %}
{% block description %}{{ wod.format }} — {{ wod.lignes|map(l => l.libelle)|join(', ') }}.{% endblock %}

{% block body %}
<div class="s-detail" {{ include('wod/_chrono_attributs.html.twig') }}>
    <div class="s-detail-principal">
        <twig:Tableau :wod="wod">
            {% if wod.consignes %}<p class="s-consignes">{{ wod.consignes }}</p>{% endif %}
            <p class="s-muted s-petit">{% if wod.auteur %}Créé par <a href="{{ path('app_athlete', {pseudo: wod.auteur.pseudo}) }}">{{ wod.auteur.pseudo }}</a> · {% endif %}ajouté le {{ wod.createdAt|format_date('long') }}</p>
        </twig:Tableau>

    </div>

    <aside class="s-detail-cote">
        <button type="button" class="s-start" data-action="chrono#ouvrir"><i>▶</i>Lancer le chrono</button>
        <div class="s-cote-actions">
            {{ include('wod/_interactions.html.twig') }}
            <button type="button" class="btn btn-icon" data-controller="partage" data-action="partage#partager" data-partage-titre-value="{{ wod.titre }} · Genwod" aria-label="Partager">{{ ux_icon('lucide:share-2') }}</button>
            {% if is_granted('WOD_GERER', wod) %}
                <form method="post" action="{{ path('app_wod_supprimer', {slug: wod.slug}) }}" class="inline-form" data-turbo-confirm="Supprimer définitivement ce WOD et tous ses résultats ?">
                    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-wod-' ~ wod.id) }}">
                    <button class="btn btn-icon" aria-label="Supprimer ce WOD">{{ ux_icon('lucide:trash-2') }}</button>
                </form>
            {% endif %}
        </div>
        {% if record %}
            <div class="s-card s-record"><small>Ton record</small><b>{{ record.scoreLisible }}</b><small>{{ record.mode.label }} · {{ record.realiseeLe|format_date('long') }}</small></div>
        {% endif %}
        <section class="s-card" id="classement">
            <div class="s-card-entete"><h2 class="s-card-titre">Classement</h2>
                <nav class="s-mini-seg">
                    <a href="{{ path('app_wod_show', {slug: wod.slug}) }}#classement" {{ modeClassement is null ? 'aria-current="page"' }}>Tous</a>
                    <a href="{{ path('app_wod_show', {slug: wod.slug, classement: 'rx'}) }}#classement" {{ modeClassement and modeClassement.value == 'rx' ? 'aria-current="page"' }}>RX</a>
                    <a href="{{ path('app_wod_show', {slug: wod.slug, classement: 'scaled'}) }}#classement" {{ modeClassement and modeClassement.value == 'scaled' ? 'aria-current="page"' }}>Scaled</a>
                </nav>
            </div>
            <ol class="s-classement">
                {% for seance in classement %}
                    <li class="{{ app.user and seance.athlete.id == app.user.id ? 'moi' }}">
                        <span class="s-rang">{{ loop.index }}</span>
                        <span class="s-avatar s-avatar-sm" style="--h: {{ seance.athlete.teinteAvatar }}">{{ seance.athlete.initiales }}</span>
                        <a href="{{ path('app_athlete', {pseudo: seance.athlete.pseudo}) }}">{{ seance.athlete.pseudo }}</a>
                        <b>{{ seance.scoreLisible }}</b>
                    </li>
                {% else %}
                    <li class="s-muted">Aucun score pour l'instant.</li>
                {% endfor %}
            </ol>
        </section>
        <section class="s-card" id="noter">
            <h2 class="s-card-titre">Noter mon score</h2>
            {{ include('wod/_seance_form.html.twig') }}
        </section>
    </aside>
        <section class="s-card s-detail-com" id="commentaires">
            <h2 class="s-card-titre">Commentaires <span class="s-muted">(<span id="nb-commentaires">{{ wod.commentaires|length }}</span>)</span></h2>
            {% if app.user %}{{ include('wod/_commentaire_form.html.twig', {form: commentaireForm}) }}{% endif %}
            <div id="commentaires-liste">
                {% for commentaire in wod.commentaires %}{{ include('wod/_commentaire.html.twig') }}{% else %}<p id="aucun-commentaire" class="s-muted">Pas encore de commentaire.</p>{% endfor %}
            </div>
        </section>
    {{ include('wod/_chrono_dialog.html.twig') }}
</div>
{% endblock %}
