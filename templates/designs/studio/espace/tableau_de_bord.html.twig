{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<header class="s-entete s-entete-ligne">
    <div><h1>Salut {{ app.user.pseudo }}</h1><p class="s-lead">{{ resume.serie > 0 ? resume.serie ~ ' jour' ~ (resume.serie > 1 ? 's' : '') ~ ' d\'affilée, continue comme ça.' : 'Une séance aujourd\'hui pour lancer ta série ?' }}</p></div>
    <a class="s-btn s-btn-noir" href="{{ path('app_generateur') }}">Générer un WOD →</a>
</header>
{{ include('espace/_nav.html.twig') }}
{% if not app.user.verified %}
    <div class="banner">{{ ux_icon('lucide:mail-warning') }}<span>Confirme ton adresse e-mail.</span>
        <form method="post" action="{{ path('app_verify_email_resend') }}" class="inline-form" style="margin-left:auto"><input type="hidden" name="_token" value="{{ csrf_token('renvoyer-confirmation') }}"><button class="btn btn-sm btn-outline">Renvoyer le lien</button></form>
    </div>
{% endif %}
<div class="s-kpi-grille">
    <div class="s-card s-kpi"><small>Séances</small><b>{{ resume.total.seances }}</b><span class="s-muted">{{ resume.mois.seances }} ce mois-ci</span></div>
    <div class="s-card s-kpi"><small>Points</small><b>{{ resume.total.points }}</b><span class="s-muted">{{ resume.mois.points }} ce mois-ci</span></div>
    <div class="s-card s-kpi s-kpi-noir"><small>Série</small><b>{{ resume.serie }} j</b><span>record : {{ resume.meilleureSerie }} j</span></div>
    <div class="s-card s-kpi"><small>En RX</small><b>{{ resume.total.seances > 0 ? (resume.total.rx / resume.total.seances * 100)|round : 0 }} %</b><span class="s-muted">des séances</span></div>
</div>
<section class="s-card"><h2 class="s-card-titre">Activité</h2><twig:Heatmap :semaines="heatmap" /></section>
<div class="s-deux">
    <section class="s-card"><h2 class="s-card-titre">Dernières séances</h2>
        <ol class="s-classement">
            {% for s in dernieres %}<li><span class="s-rang">{{ s.realiseeLe|date('d/m') }}</span><a href="{{ path('app_wod_show', {slug: s.wod.slug}) }}">{{ s.wod.titre }}</a><b>{{ s.scoreLisible }}</b></li>{% else %}<li class="s-muted">Aucune séance pour l'instant.</li>{% endfor %}
        </ol>
    </section>
    <section class="s-card"><h2 class="s-card-titre">Records personnels</h2>
        <ol class="s-classement">
            {% for r in records %}<li><span class="s-rang">PR</span><a href="{{ path('app_wod_show', {slug: r.wod.slug}) }}">{{ r.wod.titre }}</a><b>{{ r.scoreLisible }}</b></li>{% else %}<li class="s-muted">Pas encore de record.</li>{% endfor %}
        </ol>
    </section>
</div>
{% endblock %}
