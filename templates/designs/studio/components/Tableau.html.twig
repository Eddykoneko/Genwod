{# Studio : carte blanche, gros titre, lignes séparées par des filets. #}
{% props wod, titreTag = 'h1', surtitre = null %}
<article {{ attributes.defaults({class: 's-card s-board'}) }}>
    <div class="s-board-tete">
        {% if surtitre %}<span class="s-muted">{{ surtitre }}</span>{% else %}
            <span class="s-chips">
                <span class="s-chip s-{{ wod.type.value }}">{{ wod.type.label }}</span>
                <span class="s-chip s-chip-gris">{{ wod.duree }} min</span>
                <span class="s-chip s-chip-gris">{{ wod.difficulte.label }}</span>
            </span>
        {% endif %}
        {% if wod.benchmark %}<span class="s-chip">{{ wod.benchmark.label }}</span>{% endif %}
    </div>
    <{{ titreTag }} class="s-board-titre">{{ wod.titre }}</{{ titreTag }}>
    <p class="s-board-format">{{ wod.format }}</p>
    <div class="s-lignes">
        {% for ligne in wod.lignes %}
            <div>
                <b>{{ ligne.quantiteLisible }}</b>
                <span>{{ ligne.mouvement.nom }}</span>
                {% set charge = ligne.note ?? ligne.mouvement.chargeRx %}
                <small>{{ charge }}</small>
            </div>
        {% endfor %}
    </div>
    {% block content %}{% endblock %}
</article>
