{% props wod %}
<a href="{{ path('app_wod_show', {slug: wod.slug}) }}" {{ attributes.defaults({class: 's-wod'}) }}>
    <span class="s-chips">
        <span class="s-chip s-{{ wod.type.value }}">{{ wod.type.label }}</span>
        {% if wod.benchmark %}<span class="s-chip s-chip-gris">{{ wod.benchmark.label }}</span>{% endif %}
    </span>
    <h3>{{ wod.titre }}</h3>
    <span class="s-wod-format">{{ wod.format }}</span>
    <ul>
        {% for ligne in wod.lignes|slice(0, 3) %}<li>{{ ligne.libelle }}</li>{% endfor %}
        {% if wod.lignes|length > 3 %}<li class="s-muted">+ {{ wod.lignes|length - 3 }} autre{{ wod.lignes|length - 3 > 1 ? 's' }}</li>{% endif %}
    </ul>
    <span class="s-wod-bas"><span>{{ wod.difficulte.label }}</span><span>♥ {{ wod.likesCount }}</span></span>
</a>
