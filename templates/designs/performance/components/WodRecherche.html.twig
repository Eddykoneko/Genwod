<div {{ attributes }} data-loading="addClass(is-loading)" class="p-panel">
    <div class="p-biblio-filtres">
        <input type="search" data-model="debounce(300)|q" placeholder="Filtrer : titre, mouvement…" aria-label="Rechercher un WOD" autocomplete="off">
        <select data-model="benchmark" aria-label="Origine"><option value="">Toutes origines</option>{% for b in this.benchmarks %}<option value="{{ b.value }}" {{ benchmark == b ? 'selected' }}>{{ b.label }}</option>{% endfor %}</select>
        <select data-model="type" aria-label="Format"><option value="">Tous formats</option>{% for t in this.types %}<option value="{{ t.value }}" {{ type == t ? 'selected' }}>{{ t.label }}</option>{% endfor %}</select>
        <select data-model="difficulte" aria-label="Difficulté"><option value="">Toutes intensités</option>{% for d in this.difficultes %}<option value="{{ d.value }}" {{ difficulte == d ? 'selected' }}>{{ d.label }}</option>{% endfor %}</select>
        <select data-model="dureeMax" aria-label="Durée maximale"><option value="">Toutes durées</option>{% for d in [10, 15, 20, 30] %}<option value="{{ d }}" {{ dureeMax == d ? 'selected' }}>≤ {{ d }} min</option>{% endfor %}</select>
        <select data-model="tri" aria-label="Tri">
            <option value="recents" {{ tri == 'recents' ? 'selected' }}>Récents</option>
            <option value="populaires" {{ tri == 'populaires' ? 'selected' }}>Populaires</option>
            <option value="courts" {{ tri == 'courts' ? 'selected' }}>Courts</option>
        </select>
        {% if q or type or difficulte or dureeMax or benchmark %}<button type="button" class="p-btn" data-action="live#action" data-live-action-param="reinitialiser">Réinitialiser</button>{% endif %}
    </div>
    {% set resultats = this.resultats %}
    <div class="p-panel-tete"><h2 class="p-panel-titre">{{ resultats.total }} résultat{{ resultats.total > 1 ? 's' }}</h2><span>page {{ page }} / {{ resultats.nbPages }}</span></div>
    <div class="p-liste-wods results">
        {% for wod in resultats %}<twig:WodCard :wod="wod" />{% else %}<p class="p-muted">Aucun WOD. <a class="p-lien" href="{{ path('app_generateur') }}">Générer</a></p>{% endfor %}
    </div>
    {% if resultats.nbPages > 1 %}
        <nav class="pagination" aria-label="Pagination">
            <button class="p-btn" {{ not resultats.aPrecedente ? 'disabled' }} data-action="live#action" data-live-action-param="allerPage" data-live-page-param="{{ page - 1 }}">← Précédent</button>
            <button class="p-btn" {{ not resultats.aSuivante ? 'disabled' }} data-action="live#action" data-live-action-param="allerPage" data-live-page-param="{{ page + 1 }}">Suivant →</button>
        </nav>
    {% endif %}
</div>
