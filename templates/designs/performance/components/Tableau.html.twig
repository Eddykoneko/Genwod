{# Performance : panneau sombre, chiffres en mono, repères chiffrés. #}
{% props wod, titreTag = 'h1', surtitre = null %}
<article {{ attributes.defaults({class: 'p-panel p-wod'}) }}>
    <div class="p-panel-tete"><h2 class="p-panel-titre">{{ surtitre ?? 'Programme' }}</h2><span>{{ wod.benchmark ? wod.benchmark.label : 'Communauté' }}</span></div>
    <div class="p-tags">
        <span class="p-tag p-tag-{{ wod.type.value }}">{{ wod.type.label|upper }}</span>
        <span class="p-tag">{{ wod.difficulte.label|upper }}</span>
        <span class="p-tag">{{ wod.duree }} MIN</span>
    </div>
    <{{ titreTag }} class="p-wod-titre">{{ wod.titre }}</{{ titreTag }}>
    <p class="p-wod-format">{{ wod.format }}</p>
    <div class="p-rangs">
        {% for ligne in wod.lignes %}
            <div><b>{{ ligne.quantiteLisible }}</b><span>{{ ligne.mouvement.nom }}</span>{% set charge = ligne.note ?? ligne.mouvement.chargeRx %}<small>{{ charge }}</small></div>
        {% endfor %}
    </div>
    {% block content %}{% endblock %}
</article>
