{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<header class="p-entete"><h1>Salut {{ app.user.pseudo }}</h1><p>{{ 'now'|format_date('full')|capitalize }} · semaine {{ 'now'|date('W') }}</p></header>
{{ include('espace/_nav.html.twig') }}
{% if not app.user.verified %}
    <div class="banner">{{ ux_icon('lucide:mail-warning') }}<span>Confirme ton adresse e-mail.</span>
        <form method="post" action="{{ path('app_verify_email_resend') }}" class="inline-form" style="margin-left:auto"><input type="hidden" name="_token" value="{{ csrf_token('renvoyer-confirmation') }}"><button class="btn btn-sm btn-outline">Renvoyer le lien</button></form>
    </div>
{% endif %}
{# Volume hebdomadaire calculé à partir de la heatmap (séances par semaine). #}
{% set semaines = heatmap|map(s => s|reduce((total, j) => total + j.nb, 0)) %}
{% set maxSemaine = max(semaines|merge([1])) %}
<div class="p-kpis">
    <div class="p-kpi"><small>Séances · ce mois</small><b>{{ resume.mois.seances }}</b><span>{{ resume.total.seances }} au total</span></div>
    <div class="p-kpi"><small>Points</small><b>{{ resume.total.points|number_format(0, ',', ' ') }}</b><span class="p-lime">+{{ resume.mois.points }} ce mois</span></div>
    <div class="p-kpi"><small>Série en cours</small><b>{{ resume.serie }} j</b><span>record {{ resume.meilleureSerie }} j</span></div>
    <div class="p-kpi"><small>Part RX</small><b>{{ resume.total.seances > 0 ? (resume.total.rx / resume.total.seances * 100)|round : 0 }} %</b><span class="p-jauge"><i style="width: {{ resume.total.seances > 0 ? (resume.total.rx / resume.total.seances * 100)|round : 0 }}%"></i></span></div>
</div>
<div class="p-grille">
    <section class="p-panel">
        <div class="p-panel-tete"><h2 class="p-panel-titre">Volume d'entraînement</h2><span>séances par semaine · {{ semaines|length }} semaines</span></div>
        <div class="p-barres">
            {% for nb in semaines %}<div title="{{ nb }} séance(s)"><i class="{{ loop.last or loop.revindex0 == 1 ? 'h' }}" style="height: {{ max(4, (nb / maxSemaine * 100)|round) }}%"></i></div>{% endfor %}
        </div>
        <div class="p-panel-tete" style="margin-top:18px"><h2 class="p-panel-titre">Activité</h2><span>jour par jour</span></div>
        <twig:Heatmap :semaines="heatmap" />
    </section>
    <section class="p-panel">
        <div class="p-panel-tete"><h2 class="p-panel-titre">Records personnels</h2><span>{{ records|length }} WOD{{ records|length > 1 ? 's' }}</span></div>
        <table class="p-table">
            {% for r in records %}<tr><td><a href="{{ path('app_wod_show', {slug: r.wod.slug}) }}">{{ r.wod.titre }}</a></td><td><span class="p-tag">{{ r.mode.label|upper }}</span></td><td class="p-mono p-droite">{{ r.scoreLisible }}</td></tr>{% else %}<tr><td class="p-muted">Pas encore de record.</td></tr>{% endfor %}
        </table>
        <div class="p-panel-tete" style="margin-top:18px"><h2 class="p-panel-titre">Dernières séances</h2></div>
        <table class="p-table">
            {% for s in dernieres %}<tr><td class="p-mono p-muted">{{ s.realiseeLe|date('d/m') }}</td><td><a href="{{ path('app_wod_show', {slug: s.wod.slug}) }}">{{ s.wod.titre }}</a></td><td class="p-mono p-droite">{{ s.scoreLisible }}</td><td class="p-mono p-lime p-droite">+{{ s.points }}</td></tr>{% else %}<tr><td class="p-muted">Aucune séance.</td></tr>{% endfor %}
        </table>
    </section>
</div>
{% endblock %}
