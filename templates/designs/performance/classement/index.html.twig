{% extends 'base.html.twig' %}

{% block title %}Classement des athlètes{% endblock %}

{% block body %}
<header class="p-entete p-entete-ligne">
    <div><h1>Classement</h1><p>{{ periodes[periode] }} · points</p></div>
    <nav class="p-onglets">{% for cle, libelle in periodes %}<a href="{{ path('app_classement', {periode: cle}) }}" {{ periode == cle ? 'aria-current="page"' }}>{{ libelle }}</a>{% endfor %}</nav>
</header>
{% set max = classement is not empty ? (classement|first).points : 1 %}
<section class="p-panel">
    <table class="p-table p-table-grande">
        <thead><tr><th>#</th><th>Athlète</th><th class="p-cache-mobile">Séances</th><th class="p-cache-mobile">Progression</th><th class="p-droite">Points</th></tr></thead>
        <tbody>
            {% for l in classement %}
                <tr class="{{ app.user and app.user.id == l.id ? 'moi' }}">
                    <td class="p-mono {{ loop.index <= 3 ? 'p-lime' : 'p-muted' }}">{{ '%02d'|format(loop.index) }}</td>
                    <td><a href="{{ path('app_athlete', {pseudo: l.pseudo}) }}">{{ l.pseudo }}</a>{% if app.user and app.user.id == l.id %} <span class="p-tag p-tag-lime">TOI</span>{% endif %}</td>
                    <td class="p-mono p-cache-mobile">{{ l.seances }}</td>
                    <td class="p-cache-mobile"><span class="p-jauge"><i style="width: {{ (l.points / max * 100)|round }}%"></i></span></td>
                    <td class="p-mono p-droite">{{ l.points|number_format(0, ',', ' ') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="p-muted">Aucune séance sur cette période.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</section>
<p class="p-muted p-petit" style="margin-top:12px">Barème : {{ bareme.base }} pts/séance · +5/+10 intermédiaire/difficile · +{{ bareme.rx }} RX · +{{ bareme.record }} record</p>
{% endblock %}
