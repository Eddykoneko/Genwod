{% extends 'base.html.twig' %}

{% block title %}{{ wod ? wod.titre ~ ' · ' ~ wod.format : 'Générateur de WOD' }}{% endblock %}

{% block body %}
<div class="e-gen">
    <form class="e-questionnaire" method="get" action="{{ path('app_generateur') }}" data-turbo-action="advance">
        <p class="e-surtitre">Le générateur</p>
        <h1 class="e-gros-titre">Répondez à quatre questions, nous écrivons votre séance.</h1>

        <fieldset>
            <legend><span>1.</span> Quel format vous tente&nbsp;?</legend>
            <div class="e-reponses">
                {% for type in types %}
                    <label><input type="radio" name="type" value="{{ type.value }}" {{ criteres.type == type ? 'checked' }}><span>{{ type.label }}</span><small>{{ type.explication }}</small></label>
                {% endfor %}
            </div>
        </fieldset>
        <fieldset data-controller="range">
            <legend><span>2.</span> Combien de temps avez-vous&nbsp;?</legend>
            <p class="e-duree"><output for="duree" data-range-target="sortie">{{ criteres.duree }} min</output></p>
            <input type="range" id="duree" name="duree" min="4" max="40" value="{{ criteres.duree }}" data-range-target="input" data-action="input->range#maj" aria-label="Durée en minutes">
        </fieldset>
        <fieldset>
            <legend><span>3.</span> Quelle intensité&nbsp;?</legend>
            <div class="e-reponses e-reponses-ligne">
                {% for d in difficultes %}
                    <label><input type="radio" name="difficulte" value="{{ d.value }}" {{ criteres.difficulte == d ? 'checked' }}><span>{{ d.label }}</span></label>
                {% endfor %}
            </div>
        </fieldset>
        <fieldset>
            <legend><span>4.</span> De quel matériel disposez-vous&nbsp;?</legend>
            <div class="e-reponses e-reponses-ligne">
                {% for e in equipements %}
                    <label><input type="checkbox" name="materiel[]" value="{{ e.value }}" {{ e in criteres.equipements ? 'checked' }}><span>{{ e.label }}</span></label>
                {% endfor %}
            </div>
            <p class="e-note">Le poids du corps est toujours de la partie.</p>
        </fieldset>
        <button type="submit" class="btn btn-primary btn-lg">{{ wod ? 'Écrire une autre séance' : 'Écrire ma séance' }}</button>
    </form>

    {% if wod %}
        <aside class="e-gen-resultat">
            <twig:Tableau :wod="wod" titreTag="h2" />
            {% if wod.consignes %}<p class="e-lettrine">{{ wod.consignes }}</p>{% endif %}
            {{ include('generateur/_enregistrer.html.twig', {libelle_bouton: 'Publier et lancer le chrono'}) }}
            <p class="e-note">Référence de l'édition : #{{ criteres.graine }} — <button type="button" class="e-lien-bouton" data-controller="partage" data-action="partage#partager" data-partage-titre-value="{{ wod.titre }} · Genwod">partager</button></p>
        </aside>
    {% endif %}
</div>
{% endblock %}
