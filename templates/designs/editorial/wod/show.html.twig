{% extends 'base.html.twig' %}

{% block title %}{{ wod.titre }} · {{ wod.format }}{% endblock %}
{% block description %}{{ wod.format }} — {{ wod.lignes|map(l => l.libelle)|join(', ') }}.{% endblock %}

{% block body %}
<div {{ include('wod/_chrono_attributs.html.twig') }}>
<article class="e-article">
    <header class="e-article-tete">
        <p class="e-surtitre">{{ wod.benchmark ? wod.benchmark.label : 'Séance de la communauté' }} · {{ wod.type.label }}</p>
        <h1>{{ wod.titre }}</h1>
        <p class="e-chapo-une">{{ wod.format }}, niveau {{ wod.difficulte.label|lower }}.</p>
        <p class="e-signature">
            {% if wod.auteur %}Par <a href="{{ path('app_athlete', {pseudo: wod.auteur.pseudo}) }}">{{ wod.auteur.pseudo }}</a>{% else %}La rédaction{% endif %}
            · {{ wod.createdAt|format_date('long') }} · {{ wod.likesCount }} lecteur{{ wod.likesCount > 1 ? 's' }} conquis
        </p>
    </header>

    <div class="e-article-corps">
        <div class="e-article-texte">
            <p class="e-lettrine">{{ wod.consignes ?? wod.type.explication }}</p>
            <p>{{ wod.type.explication }}</p>

            <section class="e-section" id="classement">
                <h2 class="e-rubrique">Résultats</h2>
                <nav class="e-onglets">
                    <a href="{{ path('app_wod_show', {slug: wod.slug}) }}#classement" {{ modeClassement is null ? 'aria-current="page"' }}>Toutes catégories</a>
                    <a href="{{ path('app_wod_show', {slug: wod.slug, classement: 'rx'}) }}#classement" {{ modeClassement and modeClassement.value == 'rx' ? 'aria-current="page"' }}>RX</a>
                    <a href="{{ path('app_wod_show', {slug: wod.slug, classement: 'scaled'}) }}#classement" {{ modeClassement and modeClassement.value == 'scaled' ? 'aria-current="page"' }}>Scaled</a>
                </nav>
                <table class="e-resultats">
                    <tbody>
                        {% for seance in classement %}
                            <tr class="{{ app.user and seance.athlete.id == app.user.id ? 'moi' }}">
                                <td>{{ loop.index }}.</td>
                                <td><a href="{{ path('app_athlete', {pseudo: seance.athlete.pseudo}) }}">{{ seance.athlete.pseudo }}</a> <em>({{ seance.mode.label }})</em></td>
                                <td class="e-leaders"></td>
                                <td><strong>{{ seance.scoreLisible }}</strong></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4"><em>Aucun résultat publié pour l'instant.</em></td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>

            <section class="e-section" id="commentaires">
                <h2 class="e-rubrique">Courrier des lecteurs (<span id="nb-commentaires">{{ wod.commentaires|length }}</span>)</h2>
                {% if app.user %}{{ include('wod/_commentaire_form.html.twig', {form: commentaireForm}) }}{% endif %}
                <div id="commentaires-liste">
                    {% for commentaire in wod.commentaires %}
                        {{ include('wod/_commentaire.html.twig') }}
                    {% else %}
                        <p id="aucun-commentaire"><em>Soyez le premier à écrire à la rédaction.</em></p>
                    {% endfor %}
                </div>
            </section>
        </div>

        <aside class="e-article-marge">
            <twig:Tableau :wod="wod" titreTag="h2" />
            <button type="button" class="btn btn-primary btn-block" data-action="chrono#ouvrir">{{ ux_icon('lucide:timer') }} Lancer le chronomètre</button>
            <div class="e-actions">
                {{ include('wod/_interactions.html.twig') }}
                <button type="button" class="btn btn-ghost btn-sm" data-controller="partage" data-action="partage#partager" data-partage-titre-value="{{ wod.titre }} · Genwod">Partager</button>
                <button type="button" class="btn btn-ghost btn-sm" onclick="window.print()">Imprimer</button>
                {% if is_granted('WOD_GERER', wod) %}
                    <form method="post" action="{{ path('app_wod_supprimer', {slug: wod.slug}) }}" class="inline-form" data-turbo-confirm="Supprimer définitivement ce WOD et tous ses résultats ?">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer-wod-' ~ wod.id) }}">
                        <button class="btn btn-ghost btn-sm">Supprimer</button>
                    </form>
                {% endif %}
            </div>
            {% if record %}
                <p class="e-record">Votre record : <strong>{{ record.scoreLisible }}</strong> ({{ record.mode.label }}, {{ record.realiseeLe|format_date('medium') }})</p>
            {% endif %}
            <section class="e-bulletin" id="noter">
                <h2 class="e-rubrique">Bulletin de score</h2>
                {{ include('wod/_seance_form.html.twig') }}
            </section>
        </aside>
    </div>
</article>
{{ include('wod/_chrono_dialog.html.twig') }}
</div>
{% endblock %}
