{# Éditorial : le WOD comme un encadré de magazine (« Au programme »). #}
{% props wod, titreTag = 'h1' %}
<article {{ attributes.defaults({class: 'e-encadre'}) }}>
    <p class="e-surtitre">{{ wod.benchmark ? wod.benchmark.label : 'Séance du jour' }} · {{ wod.difficulte.label }}</p>
    <{{ titreTag }} class="e-encadre-titre">{{ wod.titre }}</{{ titreTag }}>
    <p class="e-chapo">{{ wod.format }}</p>
    <ol class="e-programme">
        {% for ligne in wod.lignes %}
            <li>
                <span class="e-prog-qte">{{ ligne.quantiteLisible }}</span>
                <span class="e-prog-mvt">{{ ligne.mouvement.nom }}</span>
                {% set charge = ligne.note ?? ligne.mouvement.chargeRx %}
                <span class="e-prog-charge">{{ charge }}</span>
            </li>
        {% endfor %}
    </ol>
    {% block content %}{% endblock %}
</article>
