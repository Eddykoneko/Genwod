{% extends 'base.html.twig' %}

{% block title %}Classement des athlètes{% endblock %}

{% block body %}
<header class="e-entete-page">
    <p class="e-surtitre">Résultats · {{ periodes[periode] }}</p>
    <h1 class="e-gros-titre">Le classement général</h1>
    <nav class="e-onglets">
        {% for cle, libelle in periodes %}<a href="{{ path('app_classement', {periode: cle}) }}" {{ periode == cle ? 'aria-current="page"' }}>{{ libelle }}</a>{% endfor %}
    </nav>
</header>

{% if classement|length >= 1 %}
    {% set premier = classement|first %}
    <p class="e-chapo-une e-podium-texte">
        <strong>{{ premier.pseudo }}</strong> mène la danse avec {{ premier.points }} points en {{ premier.seances }} séances{% if classement|length >= 3 %}, devant <strong>{{ classement[1].pseudo }}</strong> ({{ classement[1].points }}) et <strong>{{ classement[2].pseudo }}</strong> ({{ classement[2].points }}){% endif %}.
    </p>
{% endif %}

<table class="e-resultats e-resultats-grand">
    <thead><tr><th>Rang</th><th>Athlète</th><th></th><th>Séances</th><th>Points</th></tr></thead>
    <tbody>
        {% for l in classement %}
            <tr class="{{ app.user and app.user.id == l.id ? 'moi' }}">
                <td>{{ loop.index }}.</td>
                <td><a href="{{ path('app_athlete', {pseudo: l.pseudo}) }}">{{ l.pseudo }}</a></td>
                <td class="e-leaders"></td>
                <td>{{ l.seances }}</td>
                <td><strong>{{ l.points }}</strong></td>
            </tr>
        {% else %}
            <tr><td colspan="5"><em>Aucune séance sur cette période.</em></td></tr>
        {% endfor %}
    </tbody>
</table>
<p class="e-note">Barème : {{ bareme.base }} points par séance, +5 ou +10 selon la difficulté, +{{ bareme.rx }} en RX, +{{ bareme.record }} pour un record personnel.</p>
{% endblock %}
