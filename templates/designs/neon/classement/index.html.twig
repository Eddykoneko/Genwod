{% extends 'base.html.twig' %}

{% block title %}Classement des athlètes{% endblock %}

{% block body %}
<section class="n-salut"><p class="n-petit">Classement</p><h1>Top athlètes 🏆</h1></section>
<nav class="n-pills n-pills-centre">
    {% for cle, libelle in periodes %}<a href="{{ path('app_classement', {periode: cle}) }}" {{ periode == cle ? 'aria-current="page"' }}>{{ libelle }}</a>{% endfor %}
</nav>

{% if classement|length >= 3 %}
    <div class="n-podium">
        {% for place in [2, 1, 3] %}
            {% set l = classement[place - 1] %}
            <a class="n-podium-{{ place }}" href="{{ path('app_athlete', {pseudo: l.pseudo}) }}">
                <span class="avatar {{ place == 1 ? 'avatar-lg' }}" style="--h: {{ l.teinte }}">{{ l.pseudo|slice(0, 2)|upper }}</span>
                <strong>{{ l.pseudo }}</strong>
                <span>{{ l.points }} pts</span>
                <i>{{ place }}</i>
            </a>
        {% endfor %}
    </div>
{% endif %}

<ol class="n-liste n-tuile">
    {% for l in classement|slice(classement|length >= 3 ? 3 : 0) %}
        <li class="{{ app.user and app.user.id == l.id ? 'moi' }}">
            <span class="n-rang">{{ loop.index + (classement|length >= 3 ? 3 : 0) }}</span>
            <span class="avatar avatar-sm" style="--h: {{ l.teinte }}">{{ l.pseudo|slice(0, 2)|upper }}</span>
            <a href="{{ path('app_athlete', {pseudo: l.pseudo}) }}">{{ l.pseudo }}</a>
            <strong>{{ l.points }} pts</strong>
        </li>
    {% else %}
        <li class="n-vide">{{ classement is empty ? 'Personne sur cette période, à toi de jouer ✨' : 'Que le podium pour l\'instant !' }}</li>
    {% endfor %}
</ol>
{% endblock %}
