{% extends 'base.html.twig' %}

{% block title %}{{ wod.titre }} · {{ wod.format }}{% endblock %}
{% block description %}{{ wod.format }} — {{ wod.lignes|map(l => l.libelle)|join(', ') }}.{% endblock %}

{% block body %}
<div {{ include('wod/_chrono_attributs.html.twig') }}>
    <section class="n-hero-wod n-{{ wod.type.value }}">
        <span class="n-chip">{{ wod.benchmark ? wod.benchmark.label ~ ' · ' : '' }}{{ wod.type.label }} · {{ wod.difficulte.label }}</span>
        <h1>{{ wod.titre }}</h1>
        <p class="n-format">{{ wod.format }}</p>
        <button type="button" class="n-start" data-action="chrono#ouvrir" aria-label="Lancer le chrono">
            <span>{{ ux_icon('lucide:play') }}</span>
            <small>START</small>
        </button>
        <div class="n-hero-actions">
            {{ include('wod/_interactions.html.twig') }}
            <button type="button" class="btn btn-icon" data-controller="partage" data-action="partage#partager" data-partage-titre-value="{{ wod.titre }} · Genwod" aria-label="Partager">{{ ux_icon('lucide:share-2') }}</button>
            {% if is_granted('WOD_GERER', wod) %}
                <form method="post" action="{{ path('app_wod_supprimer', {slug: wod.slug}) }}" class="inline-form" data-turbo-confirm="Supprimer définitivement ce WOD et tous ses résultats ?">
                    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-wod-' ~ wod.id) }}">
                    <button class="btn btn-icon" aria-label="Supprimer ce WOD">{{ ux_icon('lucide:trash-2') }}</button>
                </form>
            {% endif %}
        </div>
    </section>

    <section class="n-mouvements">
        {% for ligne in wod.lignes %}
            <div class="n-mvt">
                <span class="n-mvt-num">{{ loop.index }}</span>
                <strong>{{ ligne.quantiteLisible }}</strong>
                <span>{{ ligne.mouvement.nom }}</span>
                {% set charge = ligne.note ?? ligne.mouvement.chargeRx %}
                {% if charge %}<small>{{ charge }}</small>{% endif %}
            </div>
        {% endfor %}
    </section>
    {% if wod.consignes %}<p class="n-consignes">{{ wod.consignes }}</p>{% endif %}

    <div class="n-panneaux">
        <section class="n-tuile" id="noter">
            <h2>{{ ux_icon('lucide:notebook-pen') }} Mon score</h2>
            {% if record %}
                <div class="n-record"><small>Record perso</small><strong>{{ record.scoreLisible }}</strong></div>
            {% endif %}
            {{ include('wod/_seance_form.html.twig') }}
        </section>

        <section class="n-tuile" id="classement">
            <h2>{{ ux_icon('lucide:trophy') }} Classement</h2>
            <nav class="n-pills">
                <a href="{{ path('app_wod_show', {slug: wod.slug}) }}#classement" {{ modeClassement is null ? 'aria-current="page"' }}>Tous</a>
                <a href="{{ path('app_wod_show', {slug: wod.slug, classement: 'rx'}) }}#classement" {{ modeClassement and modeClassement.value == 'rx' ? 'aria-current="page"' }}>RX</a>
                <a href="{{ path('app_wod_show', {slug: wod.slug, classement: 'scaled'}) }}#classement" {{ modeClassement and modeClassement.value == 'scaled' ? 'aria-current="page"' }}>Scaled</a>
            </nav>
            <ol class="n-liste">
                {% for seance in classement %}
                    <li class="{{ app.user and seance.athlete.id == app.user.id ? 'moi' }}">
                        <span class="n-rang">{{ loop.index }}</span>
                        <twig:Avatar :user="seance.athlete" taille="sm" />
                        <a href="{{ path('app_athlete', {pseudo: seance.athlete.pseudo}) }}">{{ seance.athlete.pseudo }}</a>
                        <strong>{{ seance.scoreLisible }}</strong>
                    </li>
                {% else %}
                    <li class="n-vide">Aucun score, à toi l'honneur ✨</li>
                {% endfor %}
            </ol>
        </section>

        <section class="n-tuile" id="commentaires">
            <h2>{{ ux_icon('lucide:message-circle') }} Chat (<span id="nb-commentaires">{{ wod.commentaires|length }}</span>)</h2>
            {% if app.user %}{{ include('wod/_commentaire_form.html.twig', {form: commentaireForm}) }}{% endif %}
            <div id="commentaires-liste">
                {% for commentaire in wod.commentaires %}
                    {{ include('wod/_commentaire.html.twig') }}
                {% else %}
                    <p id="aucun-commentaire" class="small faint">Personne n'a encore parlé.</p>
                {% endfor %}
            </div>
        </section>
    </div>

    {{ include('wod/_chrono_dialog.html.twig') }}
</div>
{% endblock %}
