{% extends 'base.html.twig' %}

{% block title %}{{ wod ? wod.titre ~ ' · ' ~ wod.format : 'Générateur de WOD' }}{% endblock %}

{% block body %}
<section class="n-salut">
    <p class="n-petit">Générateur</p>
    <h1>Mixe ton WOD 🎛️</h1>
</section>

<form class="n-mixer" method="get" action="{{ path('app_generateur') }}" data-turbo-action="advance">
    <fieldset class="n-pads">
        <legend>Format</legend>
        {% for type in types %}
            <label class="n-{{ type.value }}"><input type="radio" name="type" value="{{ type.value }}" {{ criteres.type == type ? 'checked' }}><span><strong>{{ type.label }}</strong><small>{{ {'for_time': 'Le plus vite', 'amrap': 'Max de tours', 'emom': 'Chaque minute', 'tabata': '20 s / 10 s'}[type.value] }}</small></span></label>
        {% endfor %}
    </fieldset>

    <div class="n-fader" data-controller="range">
        <label for="duree">Durée</label>
        <output for="duree" data-range-target="sortie">{{ criteres.duree }} min</output>
        <input type="range" id="duree" name="duree" min="4" max="40" value="{{ criteres.duree }}" data-range-target="input" data-action="input->range#maj">
    </div>

    <fieldset class="n-orbes">
        <legend>Intensité</legend>
        {% for d in difficultes %}
            <label><input type="radio" name="difficulte" value="{{ d.value }}" {{ criteres.difficulte == d ? 'checked' }}><span><twig:Flammes :difficulte="d" /><small>{{ d.label }}</small></span></label>
        {% endfor %}
    </fieldset>

    <fieldset class="n-materiel">
        <legend>Matériel</legend>
        <div>
            {% for e in equipements %}
                <label><input type="checkbox" name="materiel[]" value="{{ e.value }}" {{ e in criteres.equipements ? 'checked' }}><span>{{ e.label }}</span></label>
            {% endfor %}
        </div>
    </fieldset>

    <button type="submit" class="n-generer">{{ ux_icon('lucide:sparkles') }} {{ wod ? 'Remixer' : 'Générer' }}</button>
</form>

{% if wod %}
    <section class="n-resultat n-{{ wod.type.value }} reveal">
        <span class="n-chip">{{ wod.type.label }} · {{ wod.difficulte.label }}</span>
        <h2>{{ wod.titre }}</h2>
        <p class="n-format">{{ wod.format }}</p>
        <div class="n-mouvements">
            {% for ligne in wod.lignes %}
                <div class="n-mvt"><span class="n-mvt-num">{{ loop.index }}</span><strong>{{ ligne.quantiteLisible }}</strong><span>{{ ligne.mouvement.nom }}</span>{% set charge = ligne.note ?? ligne.mouvement.chargeRx %}{% if charge %}<small>{{ charge }}</small>{% endif %}</div>
            {% endfor %}
        </div>
        <div class="n-resultat-bas">
            {{ include('generateur/_enregistrer.html.twig') }}
            <p class="seed">seed #{{ criteres.graine }} · <button type="button" class="n-lien" data-controller="partage" data-action="partage#partager" data-partage-titre-value="{{ wod.titre }} · Genwod">partager</button></p>
        </div>
    </section>
{% endif %}
{% endblock %}
