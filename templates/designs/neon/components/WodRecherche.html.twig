<div {{ attributes }} data-loading="addClass(is-loading)" class="n-biblio">
    <div class="n-recherche">
        {{ ux_icon('lucide:search') }}
        <input type="search" data-model="debounce(300)|q" placeholder="Fran, burpees, Murph…" aria-label="Rechercher un WOD" autocomplete="off">
    </div>
    <div class="n-filtres">
        <select data-model="benchmark" aria-label="Origine"><option value="">✨ Tous</option>{% for b in this.benchmarks %}<option value="{{ b.value }}" {{ benchmark == b ? 'selected' }}>{{ b.label }}</option>{% endfor %}</select>
        <select data-model="type" aria-label="Format"><option value="">Format</option>{% for t in this.types %}<option value="{{ t.value }}" {{ type == t ? 'selected' }}>{{ t.label }}</option>{% endfor %}</select>
        <select data-model="difficulte" aria-label="Difficulté"><option value="">Intensité</option>{% for d in this.difficultes %}<option value="{{ d.value }}" {{ difficulte == d ? 'selected' }}>{{ d.label }}</option>{% endfor %}</select>
        <select data-model="dureeMax" aria-label="Durée maximale"><option value="">Durée</option>{% for d in [10, 15, 20, 30] %}<option value="{{ d }}" {{ dureeMax == d ? 'selected' }}>≤ {{ d }} min</option>{% endfor %}</select>
        <select data-model="tri" aria-label="Tri">
            <option value="recents" {{ tri == 'recents' ? 'selected' }}>🕒 Récents</option>
            <option value="populaires" {{ tri == 'populaires' ? 'selected' }}>🔥 Tendances</option>
            <option value="courts" {{ tri == 'courts' ? 'selected' }}>⚡ Courts</option>
        </select>
        {% if q or type or difficulte or dureeMax or benchmark %}<button type="button" class="btn btn-sm" data-action="live#action" data-live-action-param="reinitialiser">{{ ux_icon('lucide:x') }}</button>{% endif %}
    </div>

    {% set resultats = this.resultats %}
    <p class="n-petit">{{ resultats.total }} WOD{{ resultats.total > 1 ? 's' }}</p>
    <div class="n-grille results">
        {% for wod in resultats %}
            <twig:WodCard :wod="wod" />
        {% else %}
            <div class="n-tuile n-vide">Rien trouvé 🫠 <a href="{{ path('app_generateur') }}">Génère-le</a></div>
        {% endfor %}
    </div>

    {% if resultats.nbPages > 1 %}
        <nav class="pagination" aria-label="Pagination">
            <button class="btn btn-sm btn-icon" {{ not resultats.aPrecedente ? 'disabled' }} data-action="live#action" data-live-action-param="allerPage" data-live-page-param="{{ page - 1 }}" aria-label="Page précédente">{{ ux_icon('lucide:chevron-left') }}</button>
            <span class="n-petit">{{ page }} / {{ resultats.nbPages }}</span>
            <button class="btn btn-sm btn-icon" {{ not resultats.aSuivante ? 'disabled' }} data-action="live#action" data-live-action-param="allerPage" data-live-page-param="{{ page + 1 }}" aria-label="Page suivante">{{ ux_icon('lucide:chevron-right') }}</button>
        </nav>
    {% endif %}
</div>
