{% extends 'base.html.twig' %}

{% block title %}{{ wod ? wod.titre ~ ' · ' ~ wod.format : 'Générateur de WOD' }}{% endblock %}

{% block body %}
<header class="b-page-head">
    <p class="b-kicker">GÉNÉRATEUR</p>
    <h1>Programme ta séance</h1>
</header>

<form class="b-console" method="get" action="{{ path('app_generateur') }}" data-turbo-action="advance">
    <fieldset class="b-console-row">
        <legend><span>01</span> Format</legend>
        <div class="b-options">
            {% for type in types %}
                <label><input type="radio" name="type" value="{{ type.value }}" {{ criteres.type == type ? 'checked' }}><span>{{ type.label }}</span></label>
            {% endfor %}
        </div>
    </fieldset>
    <div class="b-console-row" data-controller="range">
        <label class="b-console-label" for="duree"><span>02</span> Durée</label>
        <div class="b-duree">
            <output for="duree" data-range-target="sortie">{{ criteres.duree }} min</output>
            <input type="range" id="duree" name="duree" min="4" max="40" value="{{ criteres.duree }}" data-range-target="input" data-action="input->range#maj">
        </div>
    </div>
    <fieldset class="b-console-row">
        <legend><span>03</span> Difficulté</legend>
        <div class="b-options">
            {% for d in difficultes %}
                <label><input type="radio" name="difficulte" value="{{ d.value }}" {{ criteres.difficulte == d ? 'checked' }}><span>{{ d.label }}</span></label>
            {% endfor %}
        </div>
    </fieldset>
    <fieldset class="b-console-row">
        <legend><span>04</span> Matériel</legend>
        <div class="b-options b-options-wrap">
            {% for e in equipements %}
                <label><input type="checkbox" name="materiel[]" value="{{ e.value }}" {{ e in criteres.equipements ? 'checked' }}><span>{{ e.label }}</span></label>
            {% endfor %}
        </div>
    </fieldset>
    <button type="submit" class="b-go">{{ wod ? 'Un autre !' : 'Générer' }} →</button>
</form>

{% if wod %}
    <section class="b-resultat">
        <twig:Tableau :wod="wod" titreTag="h2" />
        <div class="b-resultat-actions">
            {{ include('generateur/_enregistrer.html.twig') }}
            <p class="seed">GRAINE #{{ criteres.graine }}</p>
            <button type="button" class="btn btn-outline" data-controller="partage" data-action="partage#partager" data-partage-titre-value="{{ wod.titre }} · Genwod">{{ ux_icon('lucide:share-2') }} Partager</button>
        </div>
    </section>
{% endif %}
{% endblock %}
