{% extends 'base.html.twig' %}

{% block title %}{{ wod.titre }} · {{ wod.format }}{% endblock %}
{% block description %}{{ wod.format }} — {{ wod.lignes|map(l => l.libelle)|join(', ') }}.{% endblock %}

{% block main %}
<div class="b-split" {{ include('wod/_chrono_attributs.html.twig') }}>
    <section class="b-split-board">
        <twig:Tableau :wod="wod" />
    </section>

    <section class="b-split-panel">
        <button type="button" class="b-start" data-action="chrono#ouvrir">
            <span>START</span>
            <small>Lancer le chrono · {{ wod.type.label }}</small>
        </button>

        <div class="b-panel-row">
            {{ include('wod/_interactions.html.twig') }}
            <div class="cluster" style="--gap: 6px">
                <button type="button" class="btn btn-outline btn-icon" data-controller="partage" data-action="partage#partager" data-partage-titre-value="{{ wod.titre }} · Genwod" aria-label="Partager">{{ ux_icon('lucide:share-2') }}</button>
                {% if is_granted('WOD_GERER', wod) %}
                    <form method="post" action="{{ path('app_wod_supprimer', {slug: wod.slug}) }}" class="inline-form" data-turbo-confirm="Supprimer définitivement ce WOD et tous ses résultats ?">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer-wod-' ~ wod.id) }}">
                        <button class="btn btn-outline btn-icon" aria-label="Supprimer ce WOD">{{ ux_icon('lucide:trash-2') }}</button>
                    </form>
                {% endif %}
            </div>
        </div>

        {% if record %}
            <div class="b-record"><small>TON RECORD</small><strong>{{ record.scoreLisible }}</strong><span>{{ record.mode.label }} · {{ record.realiseeLe|date('d/m/y') }}</span></div>
        {% endif %}

        <div class="b-block" id="noter">
            <h2><span>A</span> Noter mon score</h2>
            {{ include('wod/_seance_form.html.twig') }}
        </div>

        <div class="b-block" id="classement">
            <h2><span>B</span> Classement</h2>
            <nav class="b-filtres">
                <a href="{{ path('app_wod_show', {slug: wod.slug}) }}#classement" {{ modeClassement is null ? 'aria-current="page"' }}>Tous</a>
                <a href="{{ path('app_wod_show', {slug: wod.slug, classement: 'rx'}) }}#classement" {{ modeClassement and modeClassement.value == 'rx' ? 'aria-current="page"' }}>RX</a>
                <a href="{{ path('app_wod_show', {slug: wod.slug, classement: 'scaled'}) }}#classement" {{ modeClassement and modeClassement.value == 'scaled' ? 'aria-current="page"' }}>Scaled</a>
            </nav>
            <ol class="b-scores">
                {% for seance in classement %}
                    <li class="{{ app.user and seance.athlete.id == app.user.id ? 'moi' }}">
                        <span class="b-rang">{{ loop.index }}</span>
                        <a href="{{ path('app_athlete', {pseudo: seance.athlete.pseudo}) }}">{{ seance.athlete.pseudo }}</a>
                        <small>{{ seance.mode.label }}</small>
                        <strong>{{ seance.scoreLisible }}</strong>
                    </li>
                {% else %}
                    <li class="b-vide">Aucun score. Pose le premier temps.</li>
                {% endfor %}
            </ol>
        </div>

        <div class="b-block" id="commentaires">
            <h2><span>C</span> Commentaires (<span id="nb-commentaires">{{ wod.commentaires|length }}</span>)</h2>
            {% if app.user %}{{ include('wod/_commentaire_form.html.twig', {form: commentaireForm}) }}{% endif %}
            <div id="commentaires-liste">
                {% for commentaire in wod.commentaires %}
                    {{ include('wod/_commentaire.html.twig') }}
                {% else %}
                    <p id="aucun-commentaire" class="small faint">Pas encore de commentaire.</p>
                {% endfor %}
            </div>
        </div>
    </section>

    {{ include('wod/_chrono_dialog.html.twig') }}
</div>
{% endblock %}
