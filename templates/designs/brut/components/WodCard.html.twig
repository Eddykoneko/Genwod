{# Brut : fiche verticale, numéro géant, comme une affiche de compétition. #}
{% props wod, numero = null %}
<a href="{{ path('app_wod_show', {slug: wod.slug}) }}" {{ attributes.defaults({class: 'b-card'}) }}>
    <div class="b-card-top">
        <span class="b-card-num">{{ numero ?? wod.type.label }}</span>
        <twig:Flammes :difficulte="wod.difficulte" />
    </div>
    <h3>{{ wod.titre }}</h3>
    <p class="b-card-format">{{ wod.format }}</p>
    <ul>
        {% for ligne in wod.lignes|slice(0, 4) %}<li>{{ ligne.libelle }}</li>{% endfor %}
        {% if wod.lignes|length > 4 %}<li>+ {{ wod.lignes|length - 4 }}</li>{% endif %}
    </ul>
    <footer>
        <span>{{ wod.benchmark ? wod.benchmark.label : (wod.auteur ? '@' ~ wod.auteur.pseudo : 'Généré') }}</span>
        <span>♥ {{ wod.likesCount }}</span>
    </footer>
</a>
