<div {{ attributes }} data-loading="addClass(is-loading)" class="b-biblio">
    <div class="b-biblio-filtres">
        <input type="search" class="b-recherche" data-model="debounce(300)|q" placeholder="CHERCHER : FRAN, BURPEES…" aria-label="Rechercher un WOD" autocomplete="off">
        <div class="b-selects">
            <select data-model="benchmark" aria-label="Origine"><option value="">Tous</option>{% for b in this.benchmarks %}<option value="{{ b.value }}" {{ benchmark == b ? 'selected' }}>{{ b.label }}</option>{% endfor %}</select>
            <select data-model="type" aria-label="Format"><option value="">Format</option>{% for t in this.types %}<option value="{{ t.value }}" {{ type == t ? 'selected' }}>{{ t.label }}</option>{% endfor %}</select>
            <select data-model="difficulte" aria-label="Difficulté"><option value="">Difficulté</option>{% for d in this.difficultes %}<option value="{{ d.value }}" {{ difficulte == d ? 'selected' }}>{{ d.label }}</option>{% endfor %}</select>
            <select data-model="dureeMax" aria-label="Durée maximale"><option value="">Durée</option>{% for d in [10, 15, 20, 30] %}<option value="{{ d }}" {{ dureeMax == d ? 'selected' }}>≤ {{ d }} min</option>{% endfor %}</select>
            <select data-model="tri" aria-label="Tri">
                <option value="recents" {{ tri == 'recents' ? 'selected' }}>Récents</option>
                <option value="populaires" {{ tri == 'populaires' ? 'selected' }}>Likés</option>
                <option value="courts" {{ tri == 'courts' ? 'selected' }}>Courts</option>
            </select>
            {% if q or type or difficulte or dureeMax or benchmark %}<button type="button" class="btn btn-outline btn-sm" data-action="live#action" data-live-action-param="reinitialiser">Effacer</button>{% endif %}
        </div>
    </div>

    {% set resultats = this.resultats %}
    <p class="b-compte-resultats">{{ resultats.total }} WOD{{ resultats.total > 1 ? 'S' }}</p>

    <ol class="b-liste results">
        {% for wod in resultats %}
            <li>
                <a href="{{ path('app_wod_show', {slug: wod.slug}) }}">
                    <span class="b-liste-type">{{ wod.type.label }}</span>
                    <span class="b-liste-titre">{{ wod.titre }}</span>
                    <span class="b-liste-mvts">{{ wod.lignes|map(l => l.mouvement.nom)|join(' · ') }}</span>
                    <span class="b-liste-duree">{{ wod.duree }}′</span>
                    <twig:Flammes :difficulte="wod.difficulte" />
                </a>
            </li>
        {% else %}
            <li class="b-vide">Rien trouvé. <a href="{{ path('app_generateur') }}">Génère-le →</a></li>
        {% endfor %}
    </ol>

    {% if resultats.nbPages > 1 %}
        <nav class="pagination" aria-label="Pagination">
            <button class="btn btn-outline btn-sm" {{ not resultats.aPrecedente ? 'disabled' }} data-action="live#action" data-live-action-param="allerPage" data-live-page-param="{{ page - 1 }}">← Préc.</button>
            <span class="nums">{{ page }} / {{ resultats.nbPages }}</span>
            <button class="btn btn-outline btn-sm" {{ not resultats.aSuivante ? 'disabled' }} data-action="live#action" data-live-action-param="allerPage" data-live-page-param="{{ page + 1 }}">Suiv. →</button>
        </nav>
    {% endif %}
</div>
