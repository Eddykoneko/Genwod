{# Brut : le WOD écrit au feutre sur le tableau blanc de la box. #}
{% props wod, titreTag = 'h1' %}
<article {{ attributes.defaults({class: 'b-whiteboard'}) }}>
    <div class="b-wb-head">
        <span class="b-wb-type">{{ wod.type.label }}</span>
        <span>{{ wod.duree }}′</span>
        <span><twig:Flammes :difficulte="wod.difficulte" /></span>
        {% if wod.benchmark %}<span class="b-wb-bench">{{ wod.benchmark.label }}</span>{% endif %}
    </div>
    <{{ titreTag }} class="b-wb-title">{{ wod.titre }}</{{ titreTag }}>
    <p class="b-wb-format">{{ wod.format }}</p>
    <ol class="b-wb-lines">
        {% for ligne in wod.lignes %}
            <li>
                <span class="b-wb-qte">{{ ligne.quantiteLisible }}</span>
                <span class="b-wb-mvt">{{ ligne.mouvement.nom }}</span>
                {% set charge = ligne.note ?? ligne.mouvement.chargeRx %}
                {% if charge %}<span class="b-wb-charge">{{ charge }}</span>{% endif %}
            </li>
        {% endfor %}
    </ol>
    {% if wod.consignes %}<p class="b-wb-notes">{{ wod.consignes }}</p>{% endif %}
    {% block content %}{% endblock %}
</article>
