{% extends 'base.html.twig' %}

{% block title %}Le générateur de WODs CrossFit{% endblock %}

{% block main %}
<section class="b-hero">
    <div class="b-hero-side">
        <p class="b-kicker">WOD DU JOUR</p>
        <p class="b-hero-date">{{ 'now'|format_date('full')|upper }}</p>
        <h1 class="b-hero-title">Ton WOD.<br><span>Généré.</span><br>Écrit au<br>tableau.</h1>
        <a class="btn btn-primary btn-lg" href="{{ path('app_generateur') }}">{{ ux_icon('lucide:dices') }} Générer un WOD</a>
    </div>
    <div class="b-hero-board">
        {% if wodDuJour %}
            <twig:Tableau :wod="wodDuJour" titreTag="h2">
                <div class="b-wb-actions">
                    <a class="btn btn-primary" href="{{ path('app_wod_show', {slug: wodDuJour.slug}) }}">{{ ux_icon('lucide:play') }} Faire ce WOD</a>
                    <a class="btn btn-outline" href="{{ path('app_wod_show', {slug: wodDuJour.slug}) }}#classement">Classement</a>
                </div>
            </twig:Tableau>
        {% endif %}
    </div>
</section>

<div class="b-ticker" aria-label="Genwod en chiffres">
    <div class="b-ticker-track">
        {% for i in 1..2 %}
            <span>{{ stats.wods }} WODS</span><span>★</span>
            <span>{{ stats.seances }} SÉANCES LOGGÉES</span><span>★</span>
            <span>{{ stats.athletes }} ATHLÈTES</span><span>★</span>
            <span>FOR TIME · AMRAP · EMOM · TABATA</span><span>★</span>
            <span>NO PAIN NO GAIN</span><span>★</span>
        {% endfor %}
    </div>
</div>

<div class="b-page">
    <section class="b-steps">
        {% for e in [
            ['01', 'Choisis', 'Format, durée, difficulté, matériel dispo.'],
            ['02', 'Lance le chrono', 'Décompte, bips, intervalles, écran allumé.'],
            ['03', 'Note ton score', 'Points, records perso, classement.'],
        ] %}
            <div><span>{{ e[0] }}</span><h3>{{ e[1] }}</h3><p>{{ e[2] }}</p></div>
        {% endfor %}
    </section>

    {% if populaires is not empty %}
        <section class="b-section">
            <div class="b-section-head">
                <h2>Les plus likés</h2>
                <a href="{{ path('app_wod_index', {tri: 'populaires'}) }}">Tout voir →</a>
            </div>
            <div class="b-rail">
                {% for wod in populaires %}
                    <twig:WodCard :wod="wod" :numero="'#' ~ loop.index" />
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <a class="b-cta" href="{{ path('app_generateur') }}">
        <span>Pas d'excuse.</span>
        <strong>Génère ton WOD →</strong>
    </a>
</div>
{% endblock %}
