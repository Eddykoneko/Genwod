{% extends 'base.html.twig' %}

{% block title %}{{ wod ? wod.titre ~ ' · ' ~ wod.format : 'Générateur de WOD' }}{% endblock %}

{% block body %}
<header class="l-entete"><h1>Le générateur 🎲</h1><p class="l-muted">Choisis tes options, on s'occupe du reste.</p></header>
<div class="l-gen">
    <form class="l-carte l-gen-form" method="get" action="{{ path('app_generateur') }}" data-turbo-action="advance">
        <fieldset><legend>1. Le format</legend>
            <div class="l-tuiles">
                {% for type in types %}<label class="l-{{ type.value }}"><input type="radio" name="type" value="{{ type.value }}" {{ criteres.type == type ? 'checked' }}><span><b>{{ type.label }}</b><small>{{ {'for_time': 'Le plus vite', 'amrap': 'Max de tours', 'emom': 'Chaque minute', 'tabata': '20 s / 10 s'}[type.value] }}</small></span></label>{% endfor %}
            </div>
        </fieldset>
        <div class="l-curseur" data-controller="range">
            <label for="duree">2. La durée</label>
            <output for="duree" data-range-target="sortie">{{ criteres.duree }} min</output>
            <input type="range" id="duree" name="duree" min="4" max="40" value="{{ criteres.duree }}" data-range-target="input" data-action="input->range#maj">
        </div>
        <fieldset><legend>3. L'intensité</legend>
            <div class="l-tuiles l-tuiles-3">
                {% for d in difficultes %}<label><input type="radio" name="difficulte" value="{{ d.value }}" {{ criteres.difficulte == d ? 'checked' }}><span><twig:Flammes :difficulte="d" /><small>{{ d.label }}</small></span></label>{% endfor %}
            </div>
        </fieldset>
        <fieldset><legend>4. Ton matériel</legend>
            <div class="l-pilules">
                {% for e in equipements %}<label><input type="checkbox" name="materiel[]" value="{{ e.value }}" {{ e in criteres.equipements ? 'checked' }}><span>{{ e.label }}</span></label>{% endfor %}
            </div>
        </fieldset>
        <button type="submit" class="l-btn l-btn-orange l-btn-grand l-btn-plein">{{ wod ? '🎲 Relancer les dés' : '🎲 Lancer les dés' }}</button>
    </form>
    {% if wod %}
        <twig:Tableau :wod="wod" titreTag="h2" etiquette="Tout frais !" class="reveal">
            {% if wod.consignes %}<p class="l-consignes">{{ wod.consignes }}</p>{% endif %}
            {{ include('generateur/_enregistrer.html.twig') }}
            <p class="l-muted l-petit">Graine #{{ criteres.graine }} · <button type="button" class="l-lien" data-controller="partage" data-action="partage#partager" data-partage-titre-value="{{ wod.titre }} · Genwod">partager à ta box</button></p>
        </twig:Tableau>
    {% else %}
        <div class="l-carte l-attente"><span>🎲</span><b>Lance les dés !</b><p class="l-muted">Ton WOD sur mesure apparaîtra ici.</p></div>
    {% endif %}
</div>
{% endblock %}
