<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}Générateur de WODs CrossFit{% endblock %} · Genwod</title>
        <meta name="description" content="{% block description %}Genwod génère des entraînements CrossFit (WOD) adaptés à votre niveau et à votre matériel. Chrono intégré, suivi de vos séances et classements.{% endblock %}">
        <meta name="theme-color" content="#0d0e10">
        <meta property="og:site_name" content="Genwod">
        <meta property="og:title" content="{{ block('title') }} · Genwod">
        <meta property="og:description" content="{{ block('description') }}">
        <meta property="og:type" content="website">
        <meta property="og:image" content="{{ absolute_url(asset('img/logo.png')) }}">
        <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
        <link rel="icon" href="{{ asset('img/logo.png') }}" type="image/png">
        <link rel="apple-touch-icon" href="{{ asset('img/logo.png') }}">
        <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
        {# Applique le thème choisi avant le premier rendu (évite le flash). #}
        <script>try{var t=localStorage.getItem('genwod-theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
        {# Design d'aperçu (?design=… ou choix mémorisé), appliqué avant le premier rendu. #}
        <script>try{var d=new URLSearchParams(location.search).get('design');if(d!==null)localStorage.setItem('genwod-design',d);d=localStorage.getItem('genwod-design');if(d)document.documentElement.dataset.design=d}catch(e){}</script>
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="has-tabbar">
        <a class="sr-only" href="#contenu">Aller au contenu</a>
        {{ include('_nav.html.twig') }}
        {{ include('_flashes.html.twig') }}

        <main id="contenu">
            {% block main %}
                <div class="container">
                    {% block body %}{% endblock %}
                </div>
            {% endblock %}
        </main>

        {{ include('_footer.html.twig') }}
        {{ include('_tabbar.html.twig') }}
        {{ include('_design_switcher.html.twig') }}
    </body>
</html>
