{% set route = app.current_route %}
<header class="topbar">
    <div class="container">
        <a class="brand" href="{{ path('app_accueil') }}" aria-label="Genwod, accueil">
            <img src="{{ asset('img/logo.png') }}" alt="" width="34" height="34">
            <span>Gen<b>wod</b></span>
        </a>
        <nav class="nav-links" aria-label="Navigation principale">
            <a href="{{ path('app_generateur') }}" {{ route starts with 'app_generateur' ? 'aria-current="page"' }}>Générateur</a>
            <a href="{{ path('app_wod_index') }}" {{ route starts with 'app_wod' ? 'aria-current="page"' }}>WODs</a>
            <a href="{{ path('app_classement') }}" {{ route == 'app_classement' ? 'aria-current="page"' }}>Classement</a>
            <a href="{{ path('app_a_propos') }}" {{ route == 'app_a_propos' ? 'aria-current="page"' }}>Concept</a>
        </nav>
        <div class="nav-end">
            <button type="button" class="btn btn-ghost btn-icon" data-controller="theme" data-action="theme#basculer" aria-label="Changer de thème" title="Thème clair / sombre">
                {{ ux_icon('lucide:sun-moon') }}
            </button>
            {% if app.user %}
                <details class="menu" data-controller="menu" data-action="click@window->menu#fermerSiDehors keydown.esc@window->menu#fermer">
                    <summary class="btn btn-ghost" style="padding:0 6px 0 4px" aria-label="Menu du compte">
                        <span class="avatar avatar-sm" style="--h: {{ app.user.teinteAvatar }}">{{ app.user.initiales }}</span>
                        {{ ux_icon('lucide:chevron-down', {class: 'chevron'}) }}
                    </summary>
                    <div class="menu-panel">
                        <div class="menu-head">
                            <span class="avatar" style="--h: {{ app.user.teinteAvatar }}">{{ app.user.initiales }}</span>
                            <div><strong>{{ app.user.pseudo }}</strong><div class="tiny faint">{{ app.user.email }}</div></div>
                        </div>
                        <a href="{{ path('app_tableau_de_bord') }}">{{ ux_icon('lucide:layout-dashboard') }} Tableau de bord</a>
                        <a href="{{ path('app_espace_seances') }}">{{ ux_icon('lucide:history') }} Mes séances</a>
                        <a href="{{ path('app_espace_favoris') }}">{{ ux_icon('lucide:bookmark') }} Favoris</a>
                        <a href="{{ path('app_athlete', {pseudo: app.user.pseudo}) }}">{{ ux_icon('lucide:user-round') }} Profil public</a>
                        <a href="{{ path('app_espace_profil') }}">{{ ux_icon('lucide:settings') }} Paramètres</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin') }}" data-turbo="false">{{ ux_icon('lucide:shield') }} Administration</a>
                        {% endif %}
                        <hr>
                        <a href="{{ path('app_logout') }}" data-turbo="false">{{ ux_icon('lucide:log-out') }} Se déconnecter</a>
                    </div>
                </details>
            {% else %}
                <a class="btn btn-ghost" href="{{ path('app_login') }}">Connexion</a>
                <a class="btn btn-primary btn-sm" href="{{ path('app_register') }}">S'inscrire</a>
            {% endif %}
        </div>
    </div>
</header>
