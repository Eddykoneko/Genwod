{% extends 'base.html.twig' %}

{% block title %}Classement des athlètes{% endblock %}

{% block body %}
<header class="l-entete l-entete-ligne">
    <div><h1>Classement 🏆</h1><p class="l-muted">{{ periodes[periode] }}, aux points.</p></div>
    <nav class="l-onglets">{% for cle, libelle in periodes %}<a href="{{ path('app_classement', {periode: cle}) }}" {{ periode == cle ? 'aria-current="page"' }}>{{ libelle }}</a>{% endfor %}</nav>
</header>
{% if classement|length >= 3 %}
    <div class="l-carte"><div class="l-podium l-podium-grand">
        {% for place in [2, 1, 3] %}
            {% set l = classement[place - 1] %}
            <a class="l-podium-{{ place }}" href="{{ path('app_athlete', {pseudo: l.pseudo}) }}"><span class="l-avatar" style="--h: {{ l.teinte }}">{{ l.pseudo|slice(0, 2)|upper }}</span><b>{{ l.pseudo }}</b><small>{{ l.points }} pts</small><i>{{ place }}</i></a>
        {% endfor %}
    </div></div>
{% endif %}
<ol class="l-liste l-liste-grande" start="{{ classement|length >= 3 ? 4 : 1 }}">
    {% for l in classement|slice(classement|length >= 3 ? 3 : 0) %}
        <li class="{{ app.user and app.user.id == l.id ? 'moi' }}"><span class="l-avatar l-avatar-sm" style="--h: {{ l.teinte }}">{{ l.pseudo|slice(0, 2)|upper }}</span><a href="{{ path('app_athlete', {pseudo: l.pseudo}) }}">{{ l.pseudo }}</a><span class="l-muted l-cache-mobile">{{ l.seances }} séances</span><b>{{ l.points }} pts</b></li>
    {% else %}
        {% if classement is empty %}<li class="l-muted">Personne sur cette période : la première place t'attend !</li>{% endif %}
    {% endfor %}
</ol>
<p class="l-muted l-petit" style="margin-top:14px">{{ bareme.base }} pts par séance · +5/+10 selon l'intensité · +{{ bareme.rx }} en RX · +{{ bareme.record }} pour un record 🎉</p>
{% endblock %}
