<div {{ attributes }} data-loading="addClass(is-loading)">
    <div class="l-recherche">
        <input type="search" data-model="debounce(300)|q" placeholder="🔎 Fran, burpees, Murph…" aria-label="Rechercher un WOD" autocomplete="off">
        <div class="l-filtres">
            <select data-model="benchmark" aria-label="Origine"><option value="">✨ Tous les WODs</option>{% for b in this.benchmarks %}<option value="{{ b.value }}" {{ benchmark == b ? 'selected' }}>{{ b.label }}</option>{% endfor %}</select>
            <select data-model="type" aria-label="Format"><option value="">Tous formats</option>{% for t in this.types %}<option value="{{ t.value }}" {{ type == t ? 'selected' }}>{{ t.label }}</option>{% endfor %}</select>
            <select data-model="difficulte" aria-label="Difficulté"><option value="">Toutes intensités</option>{% for d in this.difficultes %}<option value="{{ d.value }}" {{ difficulte == d ? 'selected' }}>{{ d.label }}</option>{% endfor %}</select>
            <select data-model="dureeMax" aria-label="Durée maximale"><option value="">Toutes durées</option>{% for d in [10, 15, 20, 30] %}<option value="{{ d }}" {{ dureeMax == d ? 'selected' }}>≤ {{ d }} min</option>{% endfor %}</select>
            <select data-model="tri" aria-label="Tri">
                <option value="recents" {{ tri == 'recents' ? 'selected' }}>🕒 Récents</option>
                <option value="populaires" {{ tri == 'populaires' ? 'selected' }}>❤️ Aimés</option>
                <option value="courts" {{ tri == 'courts' ? 'selected' }}>⚡ Courts</option>
            </select>
            {% if q or type or difficulte or dureeMax or benchmark %}<button type="button" class="l-btn l-btn-petit" data-action="live#action" data-live-action-param="reinitialiser">Effacer</button>{% endif %}
        </div>
    </div>
    {% set resultats = this.resultats %}
    <p class="l-muted" style="margin-bottom:14px;font-weight:700">{{ resultats.total }} WOD{{ resultats.total > 1 ? 's' }} trouvé{{ resultats.total > 1 ? 's' }}</p>
    <div class="l-grille results">
        {% for wod in resultats %}<twig:WodCard :wod="wod" />{% else %}<div class="l-carte">Rien trouvé 🫠 <a href="{{ path('app_generateur') }}">Génère-le !</a></div>{% endfor %}
    </div>
    {% if resultats.nbPages > 1 %}
        <nav class="pagination" aria-label="Pagination">
            <button class="l-btn l-btn-petit" {{ not resultats.aPrecedente ? 'disabled' }} data-action="live#action" data-live-action-param="allerPage" data-live-page-param="{{ page - 1 }}">← Avant</button>
            <span class="l-muted" style="font-weight:700">{{ page }} / {{ resultats.nbPages }}</span>
            <button class="l-btn l-btn-petit" {{ not resultats.aSuivante ? 'disabled' }} data-action="live#action" data-live-action-param="allerPage" data-live-page-param="{{ page + 1 }}">Après →</button>
        </nav>
    {% endif %}
</div>
