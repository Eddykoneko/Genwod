<div {{ attributes }} data-loading="addClass(is-loading)">
    <div class="filters">
        <div class="search-input">
            {{ ux_icon('lucide:search') }}
            <input type="search" data-model="debounce(300)|q" placeholder="Titre, mouvement… ex. « burpees », « Cindy »" aria-label="Rechercher un WOD" autocomplete="off">
        </div>
        <div class="filters-row">
            <select data-model="type" aria-label="Format">
                <option value="">Tous les formats</option>
                {% for t in this.types %}<option value="{{ t.value }}" {{ type == t ? 'selected' }}>{{ t.label }}</option>{% endfor %}
            </select>
            <select data-model="difficulte" aria-label="Difficulté">
                <option value="">Toutes difficultés</option>
                {% for d in this.difficultes %}<option value="{{ d.value }}" {{ difficulte == d ? 'selected' }}>{{ d.label }}</option>{% endfor %}
            </select>
            <select data-model="dureeMax" aria-label="Durée maximale">
                <option value="">Toutes durées</option>
                {% for d in [10, 15, 20, 30] %}<option value="{{ d }}" {{ dureeMax == d ? 'selected' }}>≤ {{ d }} min</option>{% endfor %}
            </select>
            <select data-model="tri" aria-label="Tri">
                <option value="recents" {{ tri == 'recents' ? 'selected' }}>Plus récents</option>
                <option value="populaires" {{ tri == 'populaires' ? 'selected' }}>Plus aimés</option>
                <option value="courts" {{ tri == 'courts' ? 'selected' }}>Plus courts</option>
            </select>
            {% if q or type or difficulte or dureeMax %}
                <button type="button" class="btn btn-ghost btn-sm" data-action="live#action" data-live-action-param="reinitialiser">{{ ux_icon('lucide:x') }} Effacer</button>
            {% endif %}
        </div>
    </div>

    {% set resultats = this.resultats %}
    <p class="small muted mb-2" aria-live="polite">{{ resultats.total }} WOD{{ resultats.total > 1 ? 's' }}{{ q ? ' pour « ' ~ q ~ ' »' }}</p>

    <div class="results">
        {% if resultats|length > 0 %}
            <div class="grid grid-3">
                {% for wod in resultats %}
                    <twig:WodCard :wod="wod" />
                {% endfor %}
            </div>
            {% if resultats.nbPages > 1 %}
                <nav class="pagination" aria-label="Pagination">
                    <button class="btn btn-outline btn-sm" {{ not resultats.aPrecedente ? 'disabled' }} data-action="live#action" data-live-action-param="allerPage" data-live-page-param="{{ page - 1 }}">{{ ux_icon('lucide:chevron-left') }} Précédent</button>
                    <span class="small muted nums">Page {{ page }} / {{ resultats.nbPages }}</span>
                    <button class="btn btn-outline btn-sm" {{ not resultats.aSuivante ? 'disabled' }} data-action="live#action" data-live-action-param="allerPage" data-live-page-param="{{ page + 1 }}">Suivant {{ ux_icon('lucide:chevron-right') }}</button>
                </nav>
            {% endif %}
        {% else %}
            <twig:Vide icone="lucide:search-x" titre="Aucun WOD ne correspond">
                <p>Élargissez les filtres… ou laissez le générateur en créer un sur mesure.</p>
                <p><a class="btn btn-primary" href="{{ path('app_generateur') }}">{{ ux_icon('lucide:dices') }} Générer un WOD</a></p>
            </twig:Vide>
        {% endif %}
    </div>
</div>
