{% props wod %}
<a href="{{ path('app_wod_show', {slug: wod.slug}) }}" {{ attributes.defaults({class: 'wod-card type-' ~ wod.type.value}) }}>
    <div class="cluster between">
        <twig:TypeBadge :type="wod.type" />
        <twig:Flammes :difficulte="wod.difficulte" />
    </div>
    <div>
        <h3>{{ wod.titre }}</h3>
        <p class="small muted">{{ wod.format }}</p>
    </div>
    <ul class="wod-lines">
        {% for ligne in wod.lignes|slice(0, 4) %}
            <li>{{ ligne.libelle }}</li>
        {% endfor %}
        {% if wod.lignes|length > 4 %}<li>+ {{ wod.lignes|length - 4 }} autre(s)</li>{% endif %}
    </ul>
    <footer>
        <span>
            {% if wod.benchmark %}{{ ux_icon(wod.benchmark.value == 'hero' ? 'lucide:medal' : 'lucide:badge-check', {class: 'icon-inline', style: 'color: var(--accent)'}) }} {{ wod.benchmark.label }}
            {% elseif wod.auteur %}par {{ wod.auteur.pseudo }}
            {% else %}Généré{% endif %}
        </span>
        <span class="cluster" style="--gap: 4px">{{ ux_icon('lucide:heart', {class: 'icon-inline'}) }} {{ wod.likesCount }}</span>
    </footer>
</a>
