{# Attributs du contrôleur Stimulus « chrono » : l'élément qui les porte doit contenir le bouton d'ouverture et wod/_chrono_dialog. #}
{% apply spaceless %}data-controller="chrono" data-chrono-type-value="{{ wod.type.value }}" data-chrono-duree-value="{{ wod.duree }}" data-chrono-lignes-value="{{ (wod.toutChaqueMinute ? [wod.lignes|map(l => l.libelle)|join(' · ')] : wod.lignes|map(l => wod.type.value == 'death_by' ? l.mouvementLibelle : l.libelle))|json_encode|e('html_attr') }}"{% if wod.type.value == 'death_by' %} data-chrono-pas-value="{{ wod.lignes|map(l => l.quantite)|json_encode|e('html_attr') }}"{% endif %}{% endapply %}