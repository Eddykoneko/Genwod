{# Chrono plein écran : doit être placé à l'intérieur de l'élément portant wod/_chrono_attributs. #}
<dialog class="chrono-dialog" data-chrono-target="dialog" data-action="cancel->chrono#fermer" aria-label="Chrono">
    <div class="chrono" data-chrono-target="ecran" data-etat="pret">
        <div class="chrono-top">
            <div>
                <strong style="text-transform:uppercase;font-family:var(--font-display)">{{ wod.titre }}</strong>
                <div class="tiny muted">{{ wod.format }}</div>
            </div>
            <button type="button" class="btn btn-ghost btn-icon" data-action="chrono#fermer" aria-label="Fermer le chrono">{{ ux_icon('lucide:x') }}</button>
        </div>
        <div class="chrono-center">
            <div class="chrono-phase" data-chrono-target="phase">Prêt ?</div>
            <div class="chrono-time" data-chrono-target="temps">0:00</div>
            <div class="chrono-sub" data-chrono-target="sous"></div>
            <div class="chrono-progress"><i data-chrono-target="barre"></i></div>
            {% if wod.type.value == 'amrap' or (wod.type.value == 'for_time' and (wod.tours ?? 1) > 1) %}
                <div class="tours-counter mt-2">
                    Tours <strong data-chrono-target="tours">0</strong>
                    <button type="button" class="btn btn-primary btn-icon" data-action="chrono#tourPlus" aria-label="Ajouter un tour">{{ ux_icon('lucide:plus') }}</button>
                </div>
            {% endif %}
        </div>
        <div class="chrono-actions">
            <button type="button" class="btn btn-primary btn-lg" data-chrono-target="boutonDemarrer" data-action="chrono#demarrer">{{ ux_icon('lucide:play') }} Démarrer</button>
            <button type="button" class="btn btn-outline btn-lg" data-chrono-target="boutonPause" data-action="chrono#pause" hidden>{{ ux_icon('lucide:pause') }} Pause</button>
            {% if wod.type.value == 'for_time' %}
                <button type="button" class="btn btn-lg" style="--btn-bg: var(--lime); --btn-fg: #111; --btn-border: transparent" data-chrono-target="boutonFini" data-action="chrono#terminer" hidden>{{ ux_icon('lucide:flag') }} Terminé !</button>
            {% elseif wod.type.value == 'death_by' %}
                <button type="button" class="btn btn-lg" style="--btn-bg: var(--lime); --btn-fg: #111; --btn-border: transparent" data-chrono-target="boutonFini" data-action="chrono#terminer" hidden>{{ ux_icon('lucide:flag') }} Minute ratée</button>
            {% endif %}
            <button type="button" class="btn btn-ghost btn-lg" data-action="chrono#reinitialiser">{{ ux_icon('lucide:rotate-ccw') }} Remise à zéro</button>
        </div>
    </div>
</dialog>
