{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }}{% endblock %}

{% block body %}
<div class="error-page">
    <div class="code">{{ status_code }}</div>
    <h1 style="font-size:1.8rem;text-transform:uppercase">
        {% if status_code == 404 %}Ce WOD s'est échappé
        {% elseif status_code == 403 %}Accès réservé
        {% else %}Un muscle a lâché{% endif %}
    </h1>
    <p class="muted mt-1">
        {% if status_code == 404 %}La page demandée n'existe pas (ou plus).
        {% elseif status_code == 403 %}Vous n'avez pas les droits pour voir cette page.
        {% else %}Une erreur est survenue de notre côté. Réessayez dans un instant.{% endif %}
    </p>
    <div class="cluster mt-3" style="justify-content:center">
        <a class="btn btn-primary" href="{{ path('app_accueil') }}">Retour à l'accueil</a>
        <a class="btn btn-outline" href="{{ path('app_generateur') }}">Générer un WOD</a>
    </div>
</div>
{% endblock %}
