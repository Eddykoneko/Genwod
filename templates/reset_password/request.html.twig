{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="card auth-card">
    <h1 class="mb-2">Mot de passe oublié</h1>
    <p class="muted mb-2">Indiquez l'adresse e-mail de votre compte : nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>
    {{ form_start(form) }}
        {{ form_row(form.email) }}
        <button class="btn btn-primary btn-block">Envoyer le lien</button>
    {{ form_end(form) }}
    <p class="small mt-2 text-center"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
</div>
{% endblock %}
