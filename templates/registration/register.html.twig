{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
<div class="card auth-card">
    <p class="eyebrow">Rejoins la communauté</p>
    <h1 class="mt-1 mb-2">Inscription</h1>
    {{ form_start(form) }}
        {{ form_row(form.email) }}
        {{ form_row(form.pseudo) }}
        {{ form_row(form.plainPassword) }}
        {{ form_row(form.agreeTerms, {label: 'J\'accepte les conditions d\'utilisation et la politique de confidentialité'}) }}
        <p class="tiny faint mb-2">Lire la <a href="{{ path('app_confidentialite') }}">politique de confidentialité</a>.</p>
        <button class="btn btn-primary btn-block btn-lg">Créer mon compte</button>
    {{ form_end(form) }}
    <div class="divider">Déjà inscrit·e ?</div>
    <a class="btn btn-outline btn-block" href="{{ path('app_login') }}">Se connecter</a>
</div>
{% endblock %}
