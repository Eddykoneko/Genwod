# Valeurs par défaut, versionnées. Surchargez-les dans .env.local (non versionné)
# ou via de vraies variables d'environnement en production.
# https://symfony.com/doc/current/configuration.html#configuring-environment-variables-in-env-files

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MySQL 8 / MariaDB (MAMP : port 8889, Docker : voir compose.yaml)
DATABASE_URL="mysql://genwod:genwod@127.0.0.1:3306/genwod?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# En dev, les e-mails sont capturés par Mailpit (compose.yaml) : http://localhost:8025
MAILER_DSN=smtp://127.0.0.1:1025
###< symfony/mailer ###

# Adresse d'expédition des e-mails transactionnels
MAILER_FROM="Genwod <no-reply@genwod.fr>"
